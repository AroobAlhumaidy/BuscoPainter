cff-version: 1.2.0
message: "If you use BuscoPainter, please cite it as below, and also cite BUSCO and miniprot."
title: "BuscoPainter"
abstract: "Transfers BUSCO marker-gene annotations (BUSCO genome-mode miniprot models) onto the genome assembly as annotated GenBank for viewing in Artemis. It is not a whole-genome gene prediction tool."
type: software
version: 0.1.0
# date-released: YYYY-MM-DD   # set when the release is tagged
license: MIT
repository-code: "https://github.com/AroobAlhumaidy/BuscoPainter"
